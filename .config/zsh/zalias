# LS COLORED OUTPUT
alias {l,ls}="ls --color=auto"
alias la="ls -la"
alias lh="ls -lh"
alias ll="ls -l"
alias lha="ls -lha"

# ZSH CONFIG ALIAS
alias ze="nvim $HOME/.zshenv" \
  reze="source $HOME/.zshenv" \
  zp="nvim $ZDOTDIR/.zprofile" \
  rezp="source $ZDOTDIR/.zprofile" \
  zr="nvim $ZDOTDIR/.zshrc" \
  rezr="source $ZDOTDIR/.zshrc" \
  za="nvim $ZDOTDIR/zalias" \
  reza="source $ZDOTDIR/zalias" \
  zf="nvim $ZDOTDIR/zfuncs" \
  rezf="source $ZDOTDIR/zfuncs"

# DOT FILES RELATED
alias dot="git --git-dir=$HOME/.dot --work-tree=$HOME" \
  cfg="cd $XDG_CONFIG_HOME" \
  i3cfg="cfg; cd i3; nvim config" \
  picfg="cfg; cd picom; nvim picom.conf" \
  plcfg="cfg; cd polybar; nvim config.ini" \
  qtcfg="cfg; cd qutebrowser; nvim config.py" \
  tmcfg="cfg; cd tmux; nvim tmux.conf" \
  hycfg="cfg; cd hypr; nvim hyprland.conf"

# HOME MEDIA FOLDERS
alias code="cd ~/Code" \
  pix="cd $HOME/Pictures" \
  dls="cd $HOME/Downloads" \
  dox="cd $HOME/Documents" \
  dsk="cd $HOME/Desktop" \
  anm="cd $HOME/Videos/Anime" \
  vid="cd $HOME/Videos" \
  aud="cd $HOME/Audio" \
  mus="cd $HOME/Music" \
  cv="cd $HOME/Documents/cv" \
  fem="code; cd frontendmentor.io" \
  cs="code; cd C#" \
  lc="code; cd leetcode/cs/LeetCode" \
  pt="code; cd C#/PrintPattern" \
  adv="code; cd AoC-CSharp/AoC-2023/" \
  ud='cd ~/Documents/Udacty\ -\ AIPND' \
  obs="cd ~/Obsidian" \
  iso="cd ~/Machines/ISO"

# APPLICATIONS
alias ttd="transmission-daemon" \
  ttr="transmission-remote" \
  ttl="transmission-remote --list" \
  tta="transmission-remote --add" \
  tts="transmission-show" \
  ytdl="yt-dlp"

alias bin="cd ~/.scripts/sh"
alias {v,nv,nvi}="nvim"
alias vimrc="cd $XDG_CONFIG_HOME/nvim"
alias g="git"
